__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# 虚拟环境
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp

# 系统文件
.DS_Store
Thumbs.db

# Ruff 缓存
.ruff_cache/

# pytest
.pytest_cache/

# ZCode 会话工具产物
.zcode/

# CommandCode 工具数据
.commandcode/

# Qoder Collab 工具运行时产物
.qoder-collab-runtime/

# Looptroop 工具数据与工作区（db.sqlite*、worktrees/）及其工单运行时
.looptroop/
.ticket/
