# 复制本文件为 .env 并填入你的真实配置（.env 不会被提交到仓库）

# OpenAI 兼容接口的 API 密钥
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容服务地址（DeepSeek / 通义 / Kimi 等均可）
OPENAI_API_BASE=https://api.deepseek.com/v1

# 模型名
OPENAI_MODEL=deepseek-chat

# 可选：Agent 的工作区根目录（默认当前目录）
# CODEAGENT_ROOT=/path/to/your/project

# 可选：上下文窗口预算（token，默认 65536）与压缩阈值（占预算比例，默认 0.8）
# CODEAGENT_CONTEXT_BUDGET=131072
# CODEAGENT_COMPACT_TRIGGER=0.85
