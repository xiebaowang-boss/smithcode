{
  "permissions": {
    "read_file": "allow",
    "list_dir": "allow",
    "write_file": {
      "*": "ask",
      "*.env": "deny"
    },
    "edit_file": {
      "*": "ask",
      "*.env": "deny"
    },
    "run_command": {
      "*": "ask",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "python -m pytest*": "allow",
      "rm -rf*": "deny"
    }
  }
}
